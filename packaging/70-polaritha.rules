# Give the logged-in user access to the AQIRYS configuration interfaces.
# Matched on the HID device name (BUS:VID:PID.N) so it works for USB and
# Bluetooth nodes alike (Bluetooth hidraw nodes have no USB parent).

# AQIRYS Polaris Wired mouse (USB)
SUBSYSTEM=="hidraw", KERNELS=="0003:04D9:A2E7.*", TAG+="uaccess"
# AQIRYS Talitha 2.4 GHz receiver (USB)
SUBSYSTEM=="hidraw", KERNELS=="0003:3554:FA09.*", TAG+="uaccess"
# AQIRYS Talitha over Bluetooth (BLE 0xFA07, classic "Talitha BT3.0" 0xFA08)
SUBSYSTEM=="hidraw", KERNELS=="0005:3554:FA07.*", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNELS=="0005:3554:FA08.*", TAG+="uaccess"
# AQIRYS Talitha over a USB cable
SUBSYSTEM=="hidraw", KERNELS=="0003:258A:0236.*", TAG+="uaccess"
